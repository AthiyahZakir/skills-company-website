# ── Teja Skills Backend – Environment Variables ──────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# The ID of your Google Sheet (from its URL)
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google Service Account credentials JSON
GOOGLE_KEY_FILE=./google-credentials.json

# Port the server runs on (default 5000)
PORT=5000

# Your frontend domain (e.g. https://tejaskills.com)
# Use * during local development only
FRONTEND_URL=https://your-frontend-domain.com
